{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["changes"],
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "text", "citations"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["block", "line", "quote"],
              "additionalProperties": false,
              "properties": {
                "block": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
